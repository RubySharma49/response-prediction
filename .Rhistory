if(any(arm_info$arm == "3p")){
major.al.cp = arm_info$tcn[arm_info$arm == "3p"] - arm_info$lcn[arm_info$arm == "3p"]
minor_al.cp = arm_info$lcn[arm_info$arm == "3p"]
}else{
cp.state = DNA_cnv[one.sample,"3p"]
if(is.na(cp.state)){
calc_frac = NA
}else{
if(cp.state == "Loss_LOH"){
major.al.cp = 1
minor_al.cp = 0
}
else if(cp.state == "Neutral"){
major.al.cp = 1
minor_al.cp = 1
}else if(cp.state == "Gain_LOH"){
major.al.cp = 3
minor_al.cp = 0
}else if(cp.state == "Gain"){
major.al.cp = 2
minor_al.cp = 1
}else if(cp.state == "Neutral_LOH"){
major.al.cp = 2
minor_al.cp = 0
}
}
}
calc_frac = calc_vhl_tumor_cell_fraction(m.tumor.al, ref.al, major.al.cp, minor_al.cp)
}
}
else{
m.tumor.al = NA
ref.al = NA
calc_frac = NA
major.al.cp = NA
minor_al.cp = NA
}
VHL_tumor_cell_fration[i, ] =  c(m.tumor.al, ref.al, major.al.cp, minor_al.cp, calc_frac)
}
row.names(VHL_tumor_cell_fration) = Samples_Names
colnames(VHL_tumor_cell_fration) = c("M.Tumor.allels", "Ref.allels", "Major.al.cp", "Minor.al.cp", "%Vhl_mutated_cells" )
id = match(row.names(VHL_tumor_cell_fration), Data.meta.DNA$SampleID)
id = id[!is.na(id)]
VHL_tumor_cell_fration = cbind(Data.meta.DNA[id, c("SampleID", "SampleID_corrected") ], VHL_tumor_cell_fration, Data.meta.DNA[id,c("Normal.status", "Purity", "Ploidy"  ) ] )
#write_xlsx(VHL_tumor_cell_fration, path = "/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/VHL_tumor_cell_fration.xlsx")
View(VHL_tumor_cell_fration)
Samples_Names = Data.meta.DNA$SampleID
Mutation_CCF = as.data.frame(matrix(data = NA, nrow = length(Samples_Names), ncol = ncol(DNA_cnv)+1))
colnames(Mutation_CCF) = colnames(DNA_cnv)
GeneOfInterest = colnames(Mutation_CCF)[48:ncol(Mutation_CCF)]
Mutation_CCF[,1] = Samples_Names
for(i in 1:length(Samples_Names)){
# Get one sample
sample.one = Samples_Names[i]
not_compute = FALSE
using_purity = FALSE
# Type of normal for this sample (matched or pooled)
normal = VHL_tumor_cell_fration[Align_sample_names(rownames(VHL_tumor_cell_fration)) == Align_sample_names(sample.one), "Normal.status"]
tumor_cells = NA
# When the normal is pool of cohort normal
if(normal == "Pooled_Normal"){
# Get VHL mutated cells with major allele copy number
record = VHL_tumor_cell_fration[Align_sample_names(rownames(VHL_tumor_cell_fration)) == Align_sample_names(sample.one), c("M.Tumor.allels", "Major.al.cp")]
# Total tumor cells
tumor_cells = record$M.Tumor.allels/record$Major.al.cp
# If VHL mutation is not present, then CCF can not be computed
if(is.na(tumor_cells) ){
not_compute = TRUE
}
# When the normal is obtained from matched sample of tumor
}else if(normal == "Matched_Normal"){
# Get tumor purity of the sample estimated from FACETS
tumor_cells = VHL_tumor_cell_fration[Align_sample_names(rownames(VHL_tumor_cell_fration)) == Align_sample_names(sample.one),"Purity"]
using_purity = TRUE
if(tumor_cells == "NA"){
# If tumor purity is NA, get the VHL mutated cells with major allele copy number
record = VHL_tumor_cell_fration[Align_sample_names(rownames(VHL_tumor_cell_fration))== Align_sample_names(sample.one), c("M.Tumor.allels", "Major.al.cp")]
tumor_cells = record$M.Tumor.allels/record$Major.al.cp
using_purity = FALSE
# If no VHL mutated, then CCF can not be computed
if(is.na(tumor_cells)){
not_compute = TRUE
}
}
}
# If CCF can not be computed then CCF is NA
if(not_compute){
Mutation_CCF[i, 2:ncol(Mutation_CCF)] =  NA
}else{
# Get all the somatic mutations present in the sample
sample.maf = MAFData[MAFData$Tumor_Sample_Barcode == str_replace_all(sample.one,pattern = "_", replacement = "-"),]
# Select interested somatic mutations
matched = match(GeneOfInterest, as.character(unlist(sample.maf[,1])))
Found_maf = sample.maf[as.numeric(matched[!is.na(matched)]),]
#Found_maf = Found_maf[Found_maf$Hugo_Symbol != "VHL",]
if(nrow(Found_maf) == 0){
Mutation_CCF[i, 2:ncol(Mutation_CCF)] =  NA
next()
}
# For each mutation
for(g in 1:nrow(Found_maf)){
# Get gene name and chromosome
gene = Found_maf[g, "Hugo_Symbol"]
chr = Found_maf[g, "Chromosome" ]
if(chr == "chrX"){
chr = "chr23"
}
# Get gene name and chromosome number
location = as.numeric(unlist(unique(as.vector(Found_maf[g, c("Start_Position", "End_Position"), drop = TRUE]))))
chr_Arm_size = Arm.size[Arm.size$chr == as.character(chr),]
# Get location of mutation to determine the arm
start_id = which(as.numeric(chr_Arm_size$start) < location)
end_id = which(location < as.numeric(chr_Arm_size$end))
arm = chr_Arm_size[intersect(start_id, end_id  ),"arm"]
chr = gsub(x = chr, pattern = "chr", replacement = "")
arm = paste0(chr, arm)
# Get mutation tumor alleles and reference alleles
allel.ct = Found_maf[g, c("t_ref_count", "t_alt_count")]
m.tumor.al =   allel.ct$t_alt_count
ref.al = allel.ct$t_ref_count
# Sample name reformatting to read FACETS arm level info
sample.one = gsub(pattern = "-", replacement = "_", x = sample.one)
sample.one.file <- paste("/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Facets_result/", sample.one, ".arm_level.txt", sep='')
if (!file.exists(sample.one.file)){
sample.one = gsub(pattern = "_", replacement = "-", x = sample.one)
sample.one.file <- paste("/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Facets_result/", sample.one, ".arm_level.txt", sep='')
}
if (file.exists(sample.one.file)) {
# Get tumor purity
facets.tmp <- readRDS(file = paste("/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Facets_result/", sample.one, "_hisens.rds", sep=''))
purity = facets.tmp$purity
# Reading arm level information
arm_info  = read.table(file = paste0("/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Facets_result/", sample.one, ".arm_level.txt"), header = TRUE, sep="\t")
# If mutated gene arm is present
if(any(arm_info$arm == arm)){
# Get major allele and minor allele copy number
major.al.cp = arm_info$tcn[arm_info$arm == arm] - arm_info$lcn[arm_info$arm == arm]
minor_al.cp = arm_info$lcn[arm_info$arm == arm]
# if arm copy number not present, check DNA copy number file for the copy level state
}else{
cp.state = DNA_cnv[sample.one,arm]
if(is.na(cp.state)){
calc_purity = NA
}else{
if(cp.state == "Loss_LOH"){
major.al.cp = 1
minor_al.cp = 0
}
else if(cp.state == "Neutral"){
major.al.cp = 1
minor_al.cp = 1
}else if(cp.state == "Gain_LOH"){
major.al.cp = 3
minor_al.cp = 0
}else if(cp.state == "Gain"){
major.al.cp = 2
minor_al.cp = 1
}else if(cp.state == "Neutral_LOH"){
major.al.cp = 2
minor_al.cp = 0
}
}
}
# Get number of tumor cells having gene x mutation
mutated_tumor_cells = mutated_cells(m.tumor.al, ref.al, major.al.cp, minor_al.cp)
# Get total tumor cells using tumor sample purity
if( using_purity){
tumor_cells = round(as.numeric(tumor_cells) * ((ref.al/2) + (m.tumor.al/major.al.cp)))
}
# Get cellular fraction having gene x mutation
CCF = mutated_tumor_cells/as.numeric(tumor_cells)
}
else{
m.tumor.al = NA
ref.al = NA
mutated_tumor_cells = NA
CCF = NA
}
Mutation_CCF[i, as.character(gene)] =  CCF
}
}
}
View(Mutation_CCF)
rownames(Mutation_CCF) = Samples_Names
Mutation_clonal = Mutation_CCF
for(i in 1:nrow(Mutation_CCF)){
x = as.numeric(Mutation_CCF[i, 2:ncol(Mutation_CCF) ])
Mutated_genes = which(!is.na(x))
cell_fraction = x[Mutated_genes]
names(cell_fraction) = Mutated_genes
# CCF >=0.5 is considered as clonal and CCF<0.5 is considered as subclonal
Clonal_mutated_genes = names(cell_fraction[which(as.numeric(cell_fraction)>=0.50)])
x[ as.numeric(Clonal_mutated_genes) ] = "TRUE"
x[Mutated_genes[!Mutated_genes %in% as.numeric(Clonal_mutated_genes)] ] = "FALSE"
Mutation_clonal[i,2:ncol(Mutation_clonal) ] = x
}
View(Mutation_clonal)
CNA_mutation = as.data.frame(read_xlsx(path = "/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Multi_Ins/CNA_mutation_curated_putative_genes_New_0.05_10092024.xlsx"))
CNA_segment = as.data.frame(matrix(data= NA, nrow = nrow(CNA_mutation), ncol= 7))
CNA_segment_ccf = as.data.frame(matrix(data= NA, nrow = nrow(CNA_mutation), ncol= 7))
wgii_est =  as.data.frame(matrix(data= NA, nrow = nrow(CNA_mutation), ncol= 2))
Chromosome_lengths = read.table(file = "/Volumes/pathology/Ruby_Hua_Kapur/SRM_Project/Data/Updated_Data/Chromosome_lengths.txt", header = TRUE)
# Chromosomal alterations to check for copy number alteration
CNA_seq_to_search = matrix(data = c("8q","8q_24.21-MYC", 128800000, 130100000, "9p", "9p_21.3-CDKN2A",21800000,  22200000,
"14q", "14q_23.2-HIF1A", 63700000,  64100000, "20q", "20q_13.33", 57500000, 63025520,
"4q", "4q_34.3", 180600000, 182100000,
"6q", "6q_21.33", 121000000,123000000),
nrow = 6, ncol = 4, byrow = TRUE)
colnames(CNA_seq_to_search) = c("Chr", "Seg_name", "Start", "End")
CNA_segment[,1] = CNA_mutation$SampleID
CNA_segment_ccf[,1] = CNA_mutation$SampleID
wgii_est[,1] = CNA_mutation$SampleID
for(i in 1:nrow(CNA_segment)){
sample.name = CNA_segment[i,1]
sample.name = gsub(pattern = "-", replacement = "_", x = sample.name)
sample.one.file <- paste("../../prev_work/",   sample.name, "_hisens.rds", sep='')
if (!file.exists(sample.one.file)){
sample.name = gsub(pattern = "_", replacement = "-", x = sample.name)
sample.one.file <- paste("../../prev_work/",   sample.name, "_hisens.rds", sep='')
}
if (file.exists(sample.one.file)) {
facets.tmp <- readRDS(file = sample.one.file)
purity = facets.tmp$purity
if(!is.na(purity)){
segs =  facets.tmp$segs
wgi = wgii_score( segs, Chromosome_lengths)
for(s in 1:nrow(CNA_seq_to_search)){
chr = CNA_seq_to_search[s,1]
chr_segs = segs[segs$chrom == gsub(pattern = "p|q", replacement = "", x = chr),]
st.id =  which(as.numeric(chr_segs$start) <= as.numeric(CNA_seq_to_search[s,"Start"]))
ed.id =  which(as.numeric(chr_segs$end) >= as.numeric(CNA_seq_to_search[s,"End"]))
row = intersect(st.id, ed.id )
if(length(row) != 0){
cf = chr_segs[row, "cf"]
arm_info = chr_segs[row, ]
loh = c()
loss = c()
loh[arm_info$lcn==0] = "LOH"
loss[arm_info$tcn>2] = "Gain"
loss[arm_info$tcn<2] = "Loss"
loss[arm_info$tcn==2] = "Neutral"
loss[arm_info$tcn==0] = "Total Loss"
cn_stat =  paste0(loss,"_",loh)
cn_stat = str_replace_all(cn_stat, pattern = "_NA", replacement = "")
CNA_segment[i,s+1] = cn_stat
CNA_segment_ccf[i,s+1] = cf
}
}
wgii_est[i,2] =  wgi
}else{
CNA_segment[i,s] =  NA
CNA_segment_ccf[i,s] = NA
}
}
}
colnames(  CNA_segment) = c("SampleID", CNA_seq_to_search[,2])
colnames(  CNA_segment_ccf) = c("SampleID", CNA_seq_to_search[,2])
colnames(wgii_est) = c("SampleID", "wGII")
View(CNA_segment_ccf)
